
.grn-page {
  padding: 28px;
  background: #f6f8fb;
  min-height: calc(100vh - 70px);
  box-sizing: border-box;
}


/* =========================
   PAGE HEADER
========================= */

.page-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 26px;
}

.breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #64748b;
  font-size: 13px;
  margin-bottom: 8px;
}

.breadcrumb i {
  font-size: 10px;
}

.page-header h1 {
  margin: 0;
  color: #0f172a;
  font-size: 28px;
  font-weight: 700;
}

.page-header p {
  margin: 7px 0 0;
  color: #64748b;
  font-size: 14px;
}


/* =========================
   BUTTONS
========================= */

.btn {
  border: none;
  border-radius: 8px;
  min-height: 42px;
  padding: 0 17px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: 0.2s ease;
}

.btn-primary {
  background: #2563eb;
  color: #ffffff;
}

.btn-primary:hover {
  background: #1d4ed8;
}

.btn-success {
  background: #16a34a;
  color: #ffffff;
}

.btn-success:hover {
  background: #15803d;
}

.btn-secondary {
  background: #eff6ff;
  color: #2563eb;
  border: 1px solid #dbeafe;
}

.btn-secondary:hover {
  background: #dbeafe;
}

.btn-outline {
  background: #ffffff;
  color: #334155;
  border: 1px solid #dbe2ea;
}

.btn-outline:hover {
  background: #f8fafc;
}

.btn-cancel {
  background: #ffffff;
  color: #64748b;
  border: 1px solid #e2e8f0;
}

.btn-cancel:hover {
  background: #f8fafc;
}

.btn-sm {
  min-height: 38px;
  padding: 0 14px;
}


/* =========================
   MAIN GRID
========================= */

.content-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 330px;
  gap: 22px;
  align-items: start;
}

.main-content {
  min-width: 0;
}


/* =========================
   CARD
========================= */

.card,
.summary-card,
.help-card {
  background: #ffffff;
  border: 1px solid #e5eaf0;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
}

.card {
  margin-bottom: 20px;
  overflow: hidden;
}

.card-header {
  padding: 20px 22px;
  border-bottom: 1px solid #edf1f5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.simple-header {
  justify-content: flex-start;
}

.card-header h2 {
  margin: 0;
  color: #172033;
  font-size: 17px;
  font-weight: 700;
}

.card-header p {
  margin: 5px 0 0;
  color: #64748b;
  font-size: 13px;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 11px;
  border-radius: 20px;
  background: #eff6ff;
  color: #2563eb;
  font-size: 12px;
  font-weight: 600;
}


/* =========================
   FORM
========================= */

.form-grid {
  padding: 22px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.form-group label {
  color: #334155;
  font-size: 13px;
  font-weight: 600;
}

.form-group label span {
  color: #dc2626;
}

.form-control {
  width: 100%;
  height: 42px;
  padding: 0 12px;
  border: 1px solid #dbe2ea;
  border-radius: 7px;
  background: #ffffff;
  color: #1e293b;
  font-size: 13px;
  outline: none;
  box-sizing: border-box;
  transition: 0.2s ease;
}

.form-control:focus {
  border-color: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
}

.form-control[readonly] {
  background: #f8fafc;
  color: #64748b;
}


/* =========================
   TABLE
========================= */

.table-wrapper {
  width: 100%;
  overflow-x: auto;
}

table {
  width: 100%;
  min-width: 1050px;
  border-collapse: collapse;
}

thead {
  background: #f8fafc;
}

th {
  padding: 13px 12px;
  text-align: left;
  color: #64748b;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.3px;
  white-space: nowrap;
  border-bottom: 1px solid #e5eaf0;
}

td {
  padding: 13px 12px;
  color: #334155;
  font-size: 12px;
  border-bottom: 1px solid #eef2f6;
  vertical-align: middle;
}

tbody tr:hover {
  background: #fafcff;
}

.serial {
  width: 35px;
  color: #94a3b8;
  font-weight: 600;
}

.medicine-cell {
  min-width: 165px;
}

.table-control {
  width: 100%;
  height: 36px;
  padding: 0 8px;
  border: 1px solid #dbe2ea;
  border-radius: 6px;
  background: #ffffff;
  color: #334155;
  font-size: 12px;
  outline: none;
  box-sizing: border-box;
}

.table-control:focus {
  border-color: #2563eb;
  box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.08);
}

.quantity-input {
  width: 75px;
}

.price-input {
  width: 90px;
}

.item-total {
  min-width: 90px;
  color: #172033;
  font-weight: 700;
  white-space: nowrap;
}

.remove-btn {
  width: 32px;
  height: 32px;
  border: 1px solid #fee2e2;
  border-radius: 6px;
  background: #fff7f7;
  color: #dc2626;
  cursor: pointer;
  transition: 0.2s ease;
}

.remove-btn:hover:not(:disabled) {
  background: #fee2e2;
}

.remove-btn:disabled {
  opacity: 0.35;
  cursor: not-allowed;
}

.table-note {
  padding: 13px 20px;
  display: flex;
  align-items: center;
  gap: 8px;
  color: #64748b;
  background: #f8fafc;
  font-size: 12px;
}

.table-note i {
  color: #2563eb;
}


/* =========================
   NOTES
========================= */

.notes-wrapper {
  padding: 20px 22px 22px;
}

.notes-wrapper textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid #dbe2ea;
  border-radius: 8px;
  resize: vertical;
  min-height: 105px;
  box-sizing: border-box;
  font-family: inherit;
  font-size: 13px;
  color: #334155;
  outline: none;
}

.notes-wrapper textarea:focus {
  border-color: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
}


/* =========================
   SUMMARY
========================= */

.summary-column {
  display: flex;
  flex-direction: column;
  gap: 18px;
  position: sticky;
  top: 90px;
}

.summary-card {
  padding: 20px;
}

.summary-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18px;
  border-bottom: 1px solid #edf1f5;
}

.summary-header h2 {
  margin: 0;
  color: #172033;
  font-size: 17px;
}

.summary-header p {
  margin: 5px 0 0;
  color: #64748b;
  font-size: 12px;
}

.summary-icon {
  width: 42px;
  height: 42px;
  border-radius: 10px;
  background: #eff6ff;
  color: #2563eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
}

.summary-info {
  padding: 17px 0;
  border-bottom: 1px solid #edf1f5;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 13px;
}

.summary-row:last-child {
  margin-bottom: 0;
}

.summary-row span {
  color: #64748b;
  font-size: 13px;
}

.summary-row strong {
  color: #334155;
  font-size: 13px;
}

.grand-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 0;
}

.grand-total span {
  color: #334155;
  font-size: 14px;
  font-weight: 700;
}

.grand-total strong {
  color: #2563eb;
  font-size: 21px;
  font-weight: 800;
}

.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.action-buttons .btn {
  width: 100%;
}


/* =========================
   HELP CARD
========================= */

.help-card {
  padding: 17px;
  display: flex;
  gap: 13px;
  background: #f8fbff;
  border-color: #dbeafe;
}

.help-icon {
  flex-shrink: 0;
  width: 38px;
  height: 38px;
  border-radius: 9px;
  background: #dbeafe;
  color: #2563eb;
  display: flex;
  align-items: center;
  justify-content: center;
}

.help-card h3 {
  margin: 0 0 5px;
  color: #1e3a8a;
  font-size: 13px;
}

.help-card p {
  margin: 0;
  color: #64748b;
  font-size: 12px;
  line-height: 1.6;
}


/* =========================
   RESPONSIVE
========================= */

@media (max-width: 1200px) {

  .content-grid {
    grid-template-columns: 1fr;
  }

  .summary-column {
    position: static;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

}


@media (max-width: 800px) {

  .grn-page {
    padding: 18px;
  }

  .page-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .summary-column {
    grid-template-columns: 1fr;
  }

}


@media (max-width: 500px) {

  .grn-page {
    padding: 14px;
  }

  .page-header h1 {
    font-size: 23px;
  }

  .card-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .form-grid {
    padding: 16px;
  }

  .notes-wrapper {
    padding: 16px;
  }

}
