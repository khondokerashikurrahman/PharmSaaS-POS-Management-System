/* =====================================================
   POS PAGE
===================================================== */

.pos-page {
  min-height: 100%;

  background: #f6f8fb;

  padding: 25px;

  box-sizing: border-box;
}


/* =====================================================
   HEADER
===================================================== */

.pos-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 24px;
}

.breadcrumb {
  display: flex;
  align-items: center;

  gap: 8px;

  color: #8a94a6;

  font-size: 13px;

  margin-bottom: 8px;
}

.breadcrumb i {
  font-size: 10px;
}

.pos-header h1 {
  margin: 0;

  color: #172033;

  font-size: 27px;
  font-weight: 700;
}

.pos-header p {
  margin: 6px 0 0;

  color: #7c8799;

  font-size: 14px;
}

.header-actions {
  display: flex;
  align-items: center;

  gap: 10px;
}


/* =====================================================
   SECONDARY BUTTON
===================================================== */

.secondary-btn {
  height: 42px;

  padding: 0 16px;

  border: 1px solid #dfe5ed;

  border-radius: 9px;

  background: #ffffff;

  color: #344054;

  font-size: 13px;
  font-weight: 600;

  cursor: pointer;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 8px;

  transition: all 0.2s ease;
}

.secondary-btn:hover {
  border-color: #93c5fd;

  background: #eff6ff;

  color: #2563eb;

  transform: translateY(-1px);

  box-shadow:
    0 4px 12px rgba(37, 99, 235, 0.08);
}

.secondary-btn:active {
  transform: translateY(0);
}

.return-btn {
  color: #b42318;
}

.return-btn:hover {
  border-color: #fecaca;

  background: #fff1f0;

  color: #b42318;
}


/* =====================================================
   MAIN LAYOUT
===================================================== */

.pos-layout {
  display: grid;

  grid-template-columns:
    minmax(0, 1.65fr)
    minmax(320px, 0.75fr);

  gap: 22px;

  align-items: start;
}

.pos-left,
.pos-right {
  display: flex;

  flex-direction: column;

  gap: 20px;
}


/* =====================================================
   CARD
===================================================== */

.pos-card {
  background: #ffffff;

  border: 1px solid #e8edf3;

  border-radius: 14px;

  padding: 20px;

  box-shadow:
    0 2px 8px rgba(20, 30, 50, 0.03);
}

.search-card {
  min-height: 130px;
}

.card-title {
  display: flex;
  align-items: center;

  gap: 12px;

  margin-bottom: 18px;
}

.card-title.no-margin {
  margin-bottom: 0;
}

.card-title h2 {
  margin: 0;

  color: #1d2939;

  font-size: 17px;
  font-weight: 700;
}

.card-title p {
  margin: 4px 0 0;

  color: #8a94a6;

  font-size: 12px;
}

.title-icon {
  width: 40px;
  height: 40px;

  border-radius: 10px;

  background: #eef5ff;

  color: #2563eb;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 18px;

  flex-shrink: 0;
}

.customer-icon {
  background: #f2f8f4;

  color: #16803c;
}

.cart-icon {
  background: #fff6e8;

  color: #d97706;
}


/* =====================================================
   CART
===================================================== */

.cart-card {
  padding-bottom: 22px;
}

.cart-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;

  margin-bottom: 18px;
}

.clear-btn {
  border: 0;

  background: transparent;

  color: #d92d20;

  font-size: 12px;
  font-weight: 600;

  cursor: pointer;

  display: flex;
  align-items: center;

  gap: 6px;

  padding: 7px 9px;

  border-radius: 7px;

  transition: all 0.2s ease;
}

.clear-btn:hover {
  background: #fff1f0;

  transform: translateY(-1px);
}


/* =====================================================
   SUMMARY
===================================================== */

.summary-card {
  padding: 0;

  overflow: hidden;
}

.summary-header {
  padding: 20px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-bottom: 1px solid #edf0f4;
}

.summary-header h2 {
  margin: 0;

  color: #172033;

  font-size: 18px;
  font-weight: 700;
}

.summary-header span {
  display: block;

  margin-top: 5px;

  color: #8993a5;

  font-size: 12px;
}

.summary-cart-icon {
  width: 42px;
  height: 42px;

  border-radius: 11px;

  background: #edf4ff;

  color: #2563eb;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 18px;
}

.summary-body {
  padding: 20px;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 15px;
}

.summary-row span {
  color: #667085;

  font-size: 13px;
}

.summary-row strong {
  color: #344054;

  font-size: 13px;
}

.discount-row strong {
  color: #16a34a;
}

.summary-divider {
  height: 1px;

  background: #edf0f4;

  margin: 18px 0;
}

.total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.total-row span {
  color: #172033;

  font-size: 15px;
  font-weight: 700;
}

.total-row strong {
  color: #2563eb;

  font-size: 23px;
  font-weight: 800;
}


/* =====================================================
   DISCOUNT
===================================================== */

.discount-section {
  padding: 0 20px 20px;
}


/* APPLY DISCOUNT BUTTON */

.discount-button {
  width: 100%;

  min-height: 76px;

  padding: 14px 18px;

  border: 2px dashed #8fb7ff;

  border-radius: 13px;

  background:
    linear-gradient(
      135deg,
      #f8fbff,
      #eef5ff
    );

  color: #2563eb;

  font-family: inherit;

  font-size: 17px;
  font-weight: 700;

  cursor: pointer;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 11px;

  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease,
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.discount-button i {
  font-size: 21px;

  transition:
    transform 0.2s ease;
}

.discount-button:hover {
  background:
    linear-gradient(
      135deg,
      #eef5ff,
      #e0ecff
    );

  border-color: #2563eb;

  color: #1d4ed8;

  transform: translateY(-2px);

  box-shadow:
    0 8px 20px rgba(37, 99, 235, 0.13);
}

.discount-button:hover i {
  transform:
    scale(1.12)
    rotate(-5deg);
}

.discount-button:active {
  transform: translateY(0) scale(0.99);

  box-shadow: none;
}


/* =====================================================
   DISCOUNT APPLIED
===================================================== */

.discount-applied {
  min-height: 50px;

  padding: 0 12px;

  border-radius: 10px;

  background: #f0fdf4;

  border: 1px solid #bbf7d0;

  display: flex;
  align-items: center;
  justify-content: space-between;

  transition: all 0.2s ease;
}

.discount-applied:hover {
  border-color: #86efac;

  box-shadow:
    0 4px 12px rgba(22, 163, 74, 0.08);
}

.discount-applied > div {
  display: flex;
  align-items: center;

  gap: 9px;

  color: #15803d;

  font-size: 13px;
  font-weight: 600;
}

.discount-applied > div > i {
  font-size: 16px;
}

.discount-applied small {
  margin-left: 5px;

  color: #166534;

  font-weight: 700;
}

.discount-applied button {
  width: 30px;
  height: 30px;

  border: 0;

  border-radius: 7px;

  background: transparent;

  color: #15803d;

  cursor: pointer;

  display: flex;
  align-items: center;
  justify-content: center;

  transition: all 0.2s ease;
}

.discount-applied button:hover {
  background: #dcfce7;

  color: #dc2626;

  transform: rotate(90deg);
}


/* =====================================================
   SALE ACTIONS
===================================================== */

.sale-actions {
  padding: 0 20px 20px;

  display: flex;

  flex-direction: column;

  gap: 10px;
}

.hold-btn {
  width: 100%;

  height: 42px;

  border: 1px solid #dfe5ed;

  border-radius: 9px;

  background: #ffffff;

  color: #475467;

  font-size: 13px;
  font-weight: 600;

  cursor: pointer;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 8px;

  transition: all 0.2s ease;
}

.hold-btn:hover:not(:disabled) {
  background: #f8fafc;

  border-color: #cbd5e1;

  color: #1e293b;

  transform: translateY(-1px);

  box-shadow:
    0 4px 10px rgba(15, 23, 42, 0.06);
}

.hold-btn:active:not(:disabled) {
  transform: translateY(0);
}

.hold-btn:disabled,
.payment-btn:disabled {
  opacity: 0.5;

  cursor: not-allowed;
}


/* PAYMENT */

.payment-btn {
  width: 100%;

  min-height: 52px;

  border: 0;

  border-radius: 10px;

  background: #2563eb;

  color: #ffffff;

  padding: 0 15px;

  cursor: pointer;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;

  font-size: 13px;
  font-weight: 600;

  transition: all 0.2s ease;

  box-shadow:
    0 5px 14px rgba(37, 99, 235, 0.16);
}

.payment-btn:hover:not(:disabled) {
  background: #1d4ed8;

  transform: translateY(-2px);

  box-shadow:
    0 8px 20px rgba(37, 99, 235, 0.25);
}

.payment-btn:active:not(:disabled) {
  transform: translateY(0) scale(0.99);
}

.payment-btn span {
  display: flex;
  align-items: center;

  gap: 8px;
}

.payment-btn strong {
  font-size: 14px;
}


/* =====================================================
   QUICK INFO
===================================================== */

.quick-info {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 12px;
}

.quick-item {
  min-height: 70px;

  padding: 13px;

  box-sizing: border-box;

  background: #ffffff;

  border: 1px solid #e8edf3;

  border-radius: 11px;

  display: flex;
  align-items: center;

  gap: 10px;
}

.quick-item > i {
  width: 34px;
  height: 34px;

  border-radius: 9px;

  background: #f2f6fb;

  color: #2563eb;

  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-item strong {
  display: block;

  color: #344054;

  font-size: 11px;

  margin-bottom: 3px;
}

.quick-item span {
  display: block;

  color: #98a2b3;

  font-size: 10px;
}


/* =====================================================
   RESPONSIVE
===================================================== */

@media (max-width: 1100px) {

  .pos-layout {
    grid-template-columns: 1fr;
  }

  .pos-right {
    display: grid;

    grid-template-columns: 1fr 1fr;

    align-items: start;
  }

  .quick-info {
    grid-column: span 1;
  }
}


@media (max-width: 768px) {

  .pos-page {
    padding: 16px;
  }

  .pos-header {
    flex-direction: column;

    align-items: flex-start;
  }

  .header-actions {
    width: 100%;
  }

  .secondary-btn {
    flex: 1;

    justify-content: center;
  }

  .pos-right {
    display: flex;
  }

  .quick-info {
    grid-template-columns: 1fr;
  }

  .cart-header {
    align-items: flex-start;
  }
}


@media (max-width: 480px) {

  .pos-page {
    padding: 12px;
  }

  .pos-header h1 {
    font-size: 23px;
  }

  .header-actions {
    flex-direction: column;
  }

  .secondary-btn {
    width: 100%;
  }

  .pos-card {
    padding: 15px;
  }

  .summary-card {
    padding: 0;
  }

  .summary-header,
  .summary-body {
    padding: 15px;
  }

  .discount-section,
  .sale-actions {
    padding-left: 15px;

    padding-right: 15px;
  }

  .discount-button {
    min-height: 68px;

    font-size: 15px;
  }

  .total-row strong {
    font-size: 20px;
  }
}

/* Tenant store selector for POS sales attribution */
.pos-store-selector {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.pos-store-selector label {
  color: #475569;
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
}

.pos-store-selector select {
  min-height: 36px;
  max-width: 220px;
  padding: 0 10px;
  border: 1px solid #e2e8f0;
  border-radius: 7px;
  background: #ffffff;
  color: #334155;
  font: inherit;
}

.pos-store-selector select:focus {
  outline: 2px solid #93c5fd;
  outline-offset: 1px;
}

.pos-store-selector select:disabled {
  opacity: 0.65;
}

@media (max-width: 650px) {
  .pos-store-selector {
    width: 100%;
  }

  .pos-store-selector select {
    flex: 1;
    max-width: 100%;
  }
}


/* Display the automatically selected default store without a dropdown. */
.single-store-name {
  display: inline-flex;
  align-items: center;
  min-height: 38px;
  padding: 8px 12px;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  font-weight: 600;
  white-space: nowrap;
}
