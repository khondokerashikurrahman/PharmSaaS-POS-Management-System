
import { Component, EventEmitter, Input, Output } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';

export interface ReturnSaleItem {
  id: string;
  batchId: string;
  name: string;
  sku: string;
  batchNumber: string;
  quantity: number;
  price: number;
  lineSubtotal: number;
  returnQuantity: number;
  selected: boolean;
}

export interface ReturnSaleData {
  invoice: string;
  customer: string;
  items: ReturnSaleItem[];
  reason: string;
  refundAmount: number;
}

@Component({
  selector: 'app-return-sale',
  standalone: true,
  imports: [
    CommonModule,
    FormsModule
  ],
  templateUrl: './return-sale.component.html',
  styleUrl: './return-sale.component.scss'
})
export class ReturnSaleComponent {

  @Input() sale: any = null;
  @Input() processing = false;

  @Output() closed = new EventEmitter<void>();
  @Output() returned = new EventEmitter<ReturnSaleData>();

  reason = '';

  reasons = [
    'Customer Return',
    'Wrong Product',
    'Damaged Product',
    'Expired Product',
    'Incorrect Quantity',
    'Other'
  ];

  returnItems: ReturnSaleItem[] = [];

  ngOnInit(): void {
    this.prepareItems();
  }

  prepareItems(): void {
    if (!this.sale?.saleItems) {
      this.returnItems = [];
      return;
    }

    this.returnItems = this.sale.saleItems.map(
      (item: any) => ({
        id: item.id,
        batchId: String(item.batchId ?? ''),
        name: item.name,
        sku: item.sku,
        batchNumber: item.batchNumber,
        quantity: Number(item.quantity || 0),
        price: Number(item.price || 0),
        lineSubtotal: Number(
          item.subtotal ??
          (Number(item.quantity || 0) * Number(item.price || 0))
        ),
        returnQuantity: 0,
        selected: false
      })
    );
  }

  get selectedItems(): ReturnSaleItem[] {
    return this.returnItems.filter(
      item => item.selected && item.returnQuantity > 0
    );
  }

  get refundAmount(): number {
    const lines = this.returnItems;
    const lineBaseTotal = lines.reduce(
      (sum, item) => sum + Math.max(Number(item.lineSubtotal || 0), 0),
      0
    );
    const saleTotal = Math.max(Number(this.sale?.total || 0), 0);

    // This is a UI estimate. The backend calculates and returns the
    // authoritative refund amount, including sale discounts and tax.
    if (lineBaseTotal <= 0 || saleTotal <= 0) {
      return this.selectedItems.reduce(
        (sum, item) => sum + item.returnQuantity * item.price,
        0
      );
    }

    const estimated = this.selectedItems.reduce((sum, item) => {
      const lineBase = Math.max(Number(item.lineSubtotal || 0), 0);
      const allocatedSaleTotal = saleTotal * lineBase / lineBaseTotal;
      const quantity = Math.max(Number(item.quantity || 0), 1);
      return sum + allocatedSaleTotal * item.returnQuantity / quantity;
    }, 0);

    return Math.round((estimated + Number.EPSILON) * 100) / 100;
  }

  increaseQuantity(item: ReturnSaleItem): void {
    if (item.returnQuantity < item.quantity) {
      item.returnQuantity++;
      item.selected = true;
    }
  }

  decreaseQuantity(item: ReturnSaleItem): void {
    if (item.returnQuantity > 0) {
      item.returnQuantity--;

      if (item.returnQuantity === 0) {
        item.selected = false;
      }
    }
  }

  toggleItem(item: ReturnSaleItem): void {
    item.selected = !item.selected;

    if (item.selected && item.returnQuantity === 0) {
      item.returnQuantity = 1;
    }

    if (!item.selected) {
      item.returnQuantity = 0;
    }
  }

  confirmReturn(): void {

    if (this.processing) {
      return;
    }

    if (!this.sale) {
      alert('No sale selected.');
      return;
    }

    if (this.selectedItems.length === 0) {
      alert('Please select at least one item to return.');
      return;
    }

    if (!this.reason) {
      alert('Please select a return reason.');
      return;
    }

    const confirmed = confirm(
      `Confirm return for invoice ${this.sale.invoice}?`
    );

    if (!confirmed) {
      return;
    }

    const returnData: ReturnSaleData = {
      invoice: this.sale.invoice,
      customer: this.sale.customer,
      items: this.selectedItems,
      reason: this.reason,
      refundAmount: this.refundAmount
    };

    this.returned.emit(returnData);
  }

  close(): void {
    this.closed.emit();
  }
}
