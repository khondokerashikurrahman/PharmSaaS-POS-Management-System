.tenant-page {
  min-height: 100%;
  padding: 30px;
  background: #f6f8fb;
  box-sizing: border-box;
}

/* =========================
   PAGE HEADER
========================= */

.page-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 25px;
  margin-bottom: 28px;
}

.breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 9px;
  color: #8b95a7;
  font-size: 13px;
}

.breadcrumb i {
  font-size: 11px;
}

.header-content h1 {
  margin: 0;
  color: #172033;
  font-size: 28px;
  font-weight: 700;
}

.header-content p {
  margin: 7px 0 0;
  color: #7b8495;
  font-size: 14px;
}

.add-tenant-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  border: 0;
  border-radius: 9px;
  padding: 12px 18px;
  background: #2563eb;
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: 0.2s;
}

.add-tenant-btn:hover {
  background: #1d4ed8;
  transform: translateY(-1px);
}


/* =========================
   SUMMARY
========================= */

.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-bottom: 22px;
}

.summary-card {
  display: flex;
  align-items: center;
  gap: 15px;
  padding: 20px;
  background: #fff;
  border: 1px solid #e9edf3;
  border-radius: 12px;
  box-shadow: 0 3px 12px rgba(20, 35, 60, 0.04);
}

.summary-icon {
  width: 46px;
  height: 46px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 11px;
  font-size: 20px;
}

.summary-icon.total {
  background: #eef4ff;
  color: #2563eb;
}

.summary-icon.active {
  background: #ecfdf3;
  color: #16a34a;
}

.summary-icon.pending {
  background: #fff8e7;
  color: #d97706;
}

.summary-icon.suspended {
  background: #fff0f0;
  color: #dc2626;
}

.summary-card span {
  display: block;
  margin-bottom: 5px;
  color: #8992a3;
  font-size: 12px;
}

.summary-card strong {
  color: #172033;
  font-size: 23px;
}


/* =========================
   FILTER
========================= */

.filter-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 15px;
  margin-bottom: 28px;
  background: #fff;
  border: 1px solid #e9edf3;
  border-radius: 12px;
}

.search-wrapper {
  position: relative;
  flex: 1;
}

.search-wrapper i {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  color: #98a2b3;
}

.search-wrapper input {
  width: 100%;
  height: 42px;
  padding: 0 15px 0 40px;
  border: 1px solid #e2e7ef;
  border-radius: 8px;
  outline: none;
  box-sizing: border-box;
  font-size: 13px;
}

.search-wrapper input:focus {
  border-color: #2563eb;
}

.filter-select {
  min-width: 145px;
  height: 42px;
  padding: 0 12px;
  border: 1px solid #e2e7ef;
  border-radius: 8px;
  background: #fff;
  color: #465166;
  outline: none;
  cursor: pointer;
}

.clear-btn,
.refresh-btn {
  display: flex;
  align-items: center;
  gap: 7px;
  height: 42px;
  padding: 0 14px;
  border: 1px solid #e0e5ec;
  border-radius: 8px;
  background: #fff;
  color: #596579;
  font-size: 13px;
  cursor: pointer;
}

.clear-btn:hover,
.refresh-btn:hover {
  background: #f8fafc;
}


/* =========================
   SECTION
========================= */

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.section-heading h2 {
  margin: 0;
  color: #172033;
  font-size: 19px;
}

.section-heading p {
  margin: 5px 0 0;
  color: #8a93a3;
  font-size: 13px;
}


/* =========================
   TENANT GRID
========================= */

.tenant-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}


/* =========================
   TENANT CARD
========================= */

.tenant-card {
  background: #fff;
  border: 1px solid #e7ebf1;
  border-radius: 15px;
  overflow: hidden;
  box-shadow: 0 4px 16px rgba(25, 40, 65, 0.045);
  transition: 0.25s;
}

.tenant-card:hover {
  border-color: #d5deed;
  box-shadow: 0 10px 28px rgba(25, 40, 65, 0.09);
  transform: translateY(-2px);
}

.tenant-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
  padding: 20px 20px 15px;
}

.tenant-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.tenant-logo {
  width: 48px;
  height: 48px;
  flex: 0 0 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: #eef4ff;
  color: #2563eb;
  font-size: 21px;
}

.tenant-title {
  min-width: 0;
}

.tenant-title h3 {
  margin: 0 0 4px;
  color: #172033;
  font-size: 16px;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tenant-id {
  color: #8b95a7;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.4px;
}


/* =========================
   STATUS
========================= */

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 8px;
  border-radius: 20px;
  font-size: 10px;
  font-weight: 700;
  white-space: nowrap;
}

.status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
}

.status-active {
  background: #ecfdf3;
  color: #15803d;
}

.status-pending {
  background: #fff7e6;
  color: #b45309;
}

.status-suspended {
  background: #fff1f2;
  color: #be123c;
}

.status-rejected {
  background: #f3f4f6;
  color: #6b7280;
}


/* =========================
   OWNER
========================= */

.tenant-owner {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 20px 15px;
}

.owner-avatar {
  width: 35px;
  height: 35px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f0f4fa;
  color: #43516a;
  font-size: 13px;
  font-weight: 700;
}

.tenant-owner span,
.plan-info span,
.billing span {
  display: block;
  color: #99a2b1;
  font-size: 10px;
  margin-bottom: 2px;
}

.tenant-owner strong {
  color: #364154;
  font-size: 12px;
}


/* =========================
   CONTACT
========================= */

.contact-info {
  padding: 13px 20px;
  border-top: 1px solid #eef1f5;
  border-bottom: 1px solid #eef1f5;
}

.contact-info div {
  display: flex;
  align-items: center;
  gap: 9px;
  margin: 7px 0;
}

.contact-info i {
  width: 15px;
  color: #8b97a9;
  font-size: 13px;
}

.contact-info span {
  color: #697487;
  font-size: 11px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}


/* =========================
   PLAN
========================= */

.plan-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px 20px;
}

.plan-info strong {
  display: inline-block;
  padding: 4px 9px;
  border-radius: 5px;
  font-size: 10px;
}

.plan-basic {
  background: #f2f4f7;
  color: #475467;
}

.plan-standard {
  background: #eef4ff;
  color: #2563eb;
}

.plan-premium {
  background: #f5efff;
  color: #7c3aed;
}

.billing {
  text-align: right;
}

.billing strong {
  color: #172033;
  font-size: 14px;
}


/* =========================
   STATS
========================= */

.tenant-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin: 0 20px 16px;
  padding: 12px 0;
  border-top: 1px solid #eef1f5;
  border-bottom: 1px solid #eef1f5;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 0 7px;
  border-right: 1px solid #edf0f4;
}

.stat-item:last-child {
  border-right: 0;
}

.stat-item i {
  color: #8d98a9;
  font-size: 13px;
}

.stat-item strong {
  display: block;
  color: #344054;
  font-size: 11px;
}

.stat-item span {
  display: block;
  color: #98a1af;
  font-size: 9px;
  margin-top: 1px;
}


/* =========================
   ACTIONS
========================= */

.card-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  padding: 0 20px 12px;
}

.view-btn,
.enter-btn {
  height: 37px;
  border-radius: 7px;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  transition: 0.2s;
}

.view-btn {
  border: 1px solid #dce3ed;
  background: #fff;
  color: #465469;
}

.view-btn:hover {
  background: #f8fafc;
}

.enter-btn {
  border: 0;
  background: #2563eb;
  color: #fff;
}

.enter-btn:hover:not(:disabled) {
  background: #1d4ed8;
}

.enter-btn:disabled {
  background: #d9dee7;
  color: #8791a2;
  cursor: not-allowed;
}


/* =========================
   MANAGEMENT ACTIONS
========================= */

.management-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  padding: 11px 20px 15px;
  background: #fafbfc;
}

.small-action {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 5px 8px;
  border: 0;
  border-radius: 5px;
  background: transparent;
  font-size: 10px;
  font-weight: 600;
  cursor: pointer;
}

.small-action.approve {
  color: #15803d;
  background: #ecfdf3;
}

.small-action.suspend {
  color: #b45309;
  background: #fff7e6;
}

.small-action.activate {
  color: #2563eb;
  background: #eef4ff;
}

.small-action.reject,
.small-action.delete {
  color: #dc2626;
  background: #fff1f2;
}


/* =========================
   EMPTY
========================= */

.empty-state {
  padding: 70px 20px;
  text-align: center;
  background: #fff;
  border: 1px solid #e7ebf1;
  border-radius: 14px;
}

.empty-icon {
  width: 60px;
  height: 60px;
  margin: 0 auto 15px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f1f4f8;
  color: #8d98a9;
  font-size: 24px;
}

.empty-state h3 {
  margin: 0 0 6px;
  color: #344054;
}

.empty-state p {
  margin: 0 0 15px;
  color: #8b95a7;
  font-size: 13px;
}


/* =========================
   MODAL
========================= */

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 5000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: rgba(15, 23, 42, 0.55);
}

.tenant-modal {
  width: 100%;
  max-width: 540px;
  max-height: 90vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 14px;
  box-shadow: 0 25px 70px rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: 22px;
  border-bottom: 1px solid #edf0f4;
}

.modal-header h2 {
  margin: 0;
  color: #172033;
  font-size: 19px;
}

.modal-header p {
  margin: 5px 0 0;
  color: #8a93a3;
  font-size: 12px;
}

.close-btn {
  width: 34px;
  height: 34px;
  border: 0;
  border-radius: 7px;
  background: #f4f6f8;
  color: #667085;
  cursor: pointer;
}

.modal-body {
  padding: 22px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.form-group {
  margin-bottom: 16px;
}

.form-group label {
  display: block;
  margin-bottom: 7px;
  color: #344054;
  font-size: 12px;
  font-weight: 600;
}

.form-group input,
.form-group select {
  width: 100%;
  height: 42px;
  padding: 0 12px;
  box-sizing: border-box;
  border: 1px solid #dfe4eb;
  border-radius: 7px;
  outline: none;
  font-size: 12px;
}

.form-group input:focus,
.form-group select:focus {
  border-color: #2563eb;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 9px;
  padding: 15px 22px;
  border-top: 1px solid #edf0f4;
}

.cancel-btn,
.save-btn {
  height: 39px;
  padding: 0 15px;
  border-radius: 7px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
}

.cancel-btn {
  border: 1px solid #dce2e9;
  background: #fff;
  color: #667085;
}

.save-btn {
  border: 0;
  background: #2563eb;
  color: #fff;
}


/* =========================
   RESPONSIVE
========================= */

@media (max-width: 1200px) {

  .tenant-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .summary-grid {
    grid-template-columns: repeat(2, 1fr);
  }

}

@media (max-width: 850px) {

  .tenant-page {
    padding: 20px;
  }

  .page-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .filter-card {
    flex-wrap: wrap;
  }

  .search-wrapper {
    flex: 100%;
  }

}

@media (max-width: 650px) {

  .tenant-grid {
    grid-template-columns: 1fr;
  }

  .summary-grid {
    grid-template-columns: 1fr;
  }

  .filter-select {
    flex: 1;
    min-width: 120px;
  }

  .tenant-card-header {
    flex-direction: column;
  }

  .status-badge {
    align-self: flex-start;
  }

  .form-row {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .card-actions {
    grid-template-columns: 1fr;
  }

}
/* =========================
   TENANT REJECTION REASON
========================= */

.reject-backdrop {
  z-index: 10000;
}

.reject-reason-modal {
  position: relative;
}

.reject-tenant-name {
  margin: 0 0 20px;
  color: #475467;
  font-size: 13px;
}

.reject-tenant-name strong {
  color: #172033;
}

.reject-reason-modal textarea {
  display: block;
  width: 100%;
  min-height: 120px;
  padding: 12px;
  box-sizing: border-box;
  resize: vertical;
  border: 1px solid #dfe4eb;
  border-radius: 8px;
  outline: none;
  color: #344054;
  font: inherit;
  font-size: 13px;
  line-height: 1.5;
}

.reject-reason-modal textarea:focus {
  border-color: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
}

.reject-reason-modal .form-group small {
  display: block;
  margin-top: 6px;
  color: #8992a3;
  font-size: 11px;
}

.reject-submit-btn {
  background: #dc2626;
}

.reject-submit-btn:hover:not(:disabled) {
  background: #b91c1c;
}

.reject-reason-modal button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}
