
.medicine-form-page {
  min-height: 100%;
  padding: 28px;
  background: #f5f7fb;
  box-sizing: border-box;
}

/* =========================================
   PAGE HEADER
========================================= */

.page-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 24px;
}

.header-left {
  flex: 1;
}

.breadcrumb {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 10px;
  color: #8a94a6;
  font-size: 13px;
  font-weight: 500;
}

.breadcrumb i {
  font-size: 10px;
  color: #aab2bf;
}

.breadcrumb .current {
  color: #4d5868;
}

.page-header h1 {
  margin: 0;
  color: #1f2937;
  font-size: 28px;
  font-weight: 700;
  line-height: 1.25;
}

.page-header p {
  margin: 7px 0 0;
  color: #7b8494;
  font-size: 14px;
}

.header-actions {
  flex-shrink: 0;
}

/* =========================================
   BUTTONS
========================================= */

.btn {
  height: 42px;
  padding: 0 18px;
  border: 1px solid transparent;
  border-radius: 8px;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  font-family: inherit;
  font-size: 14px;
  font-weight: 600;

  cursor: pointer;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.btn i {
  font-size: 15px;
}

.btn-light {
  background: #ffffff;
  color: #4b5563;
  border-color: #e1e6ed;
}

.btn-light:hover {
  background: #f8fafc;
  border-color: #cfd6df;
}

.btn-secondary {
  background: #eef1f5;
  color: #4b5563;
  border-color: #eef1f5;
}

.btn-secondary:hover {
  background: #e3e7ed;
}

.btn-outline {
  background: #ffffff;
  color: #4b5563;
  border-color: #d8dee7;
}

.btn-outline:hover {
  background: #f8fafc;
  border-color: #c4ccd7;
}

.btn-primary {
  min-width: 155px;
  background: #1f2937;
  color: #ffffff;
  border-color: #1f2937;
}

.btn-primary:hover:not(:disabled) {
  background: #111827;
  border-color: #111827;
  transform: translateY(-1px);
}

.btn-primary:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

/* =========================================
   FORM CARD
========================================= */

.form-card {
  background: #ffffff;
  border: 1px solid #e6eaf0;
  border-radius: 12px;
  margin-bottom: 20px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(31, 41, 55, 0.03);
}

.card-header {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 20px 24px;
  border-bottom: 1px solid #edf0f4;
}

.header-icon {
  width: 42px;
  height: 42px;
  flex-shrink: 0;

  border-radius: 10px;
  background: #eef2ff;
  color: #4f46e5;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 19px;
}

.inventory-icon {
  background: #ecfdf3;
  color: #16803c;
}

.description-icon {
  background: #fff7ed;
  color: #c2410c;
}

.card-header h2 {
  margin: 0;
  color: #202938;
  font-size: 16px;
  font-weight: 700;
}

.card-header p {
  margin: 4px 0 0;
  color: #8a94a6;
  font-size: 13px;
}

.card-body {
  padding: 24px;
}

/* =========================================
   FORM GRID
========================================= */

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 24px;
  row-gap: 21px;
}

.form-group {
  min-width: 0;
}

.full-width {
  width: 100%;
}

.form-group label {
  display: block;
  margin-bottom: 8px;
  color: #374151;
  font-size: 13px;
  font-weight: 600;
}

.form-group label span {
  color: #dc2626;
  margin-left: 2px;
}

.form-group small {
  display: block;
  margin-top: 6px;
  color: #98a1af;
  font-size: 11px;
  line-height: 1.4;
}

/* =========================================
   INPUTS
========================================= */

.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.input-wrapper > i {
  position: absolute;
  left: 13px;

  color: #9aa4b2;
  font-size: 16px;

  pointer-events: none;
  z-index: 1;
}

.input-wrapper input,
.input-wrapper select,
.form-group textarea {
  width: 100%;

  border: 1px solid #dce2e9;
  border-radius: 8px;

  background: #ffffff;
  color: #293241;

  font-family: inherit;
  font-size: 14px;

  outline: none;
  box-sizing: border-box;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.input-wrapper input,
.input-wrapper select {
  height: 44px;
}

.input-wrapper input {
  padding: 0 14px 0 40px;
}

.input-wrapper select {
  padding: 0 38px 0 40px;
  cursor: pointer;

  appearance: none;

  background-image:
    linear-gradient(45deg, transparent 50%, #8b95a5 50%),
    linear-gradient(135deg, #8b95a5 50%, transparent 50%);

  background-position:
    calc(100% - 17px) 18px,
    calc(100% - 12px) 18px;

  background-size: 5px 5px, 5px 5px;
  background-repeat: no-repeat;
}

.input-wrapper input::placeholder,
.form-group textarea::placeholder {
  color: #b0b7c3;
}

.input-wrapper input:focus,
.input-wrapper select:focus,
.form-group textarea:focus {
  border-color: #64748b;
  box-shadow: 0 0 0 3px rgba(100, 116, 139, 0.1);
}

.input-wrapper input:hover,
.input-wrapper select:hover,
.form-group textarea:hover {
  border-color: #c8d0da;
}

/* =========================================
   PRICE INPUT
========================================= */

.price-input {
  position: relative;
}

.price-input .currency {
  position: absolute;
  left: 14px;

  color: #6b7280;
  font-size: 15px;
  font-weight: 700;

  z-index: 2;
  pointer-events: none;
}

.price-input input {
  padding-left: 34px;
}

/* =========================================
   TEXTAREA
========================================= */

.form-group textarea {
  display: block;
  min-height: 120px;
  padding: 13px 14px;

  resize: vertical;
  line-height: 1.6;
}

/* =========================================
   STOCK INFO
========================================= */

.stock-info {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto 1fr;

  align-items: center;

  margin-top: 25px;
  padding: 17px 20px;

  background: #f8fafc;
  border: 1px solid #edf0f4;
  border-radius: 10px;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 10px;
}

.info-icon {
  width: 36px;
  height: 36px;
  flex-shrink: 0;

  border-radius: 8px;

  background: #eef2ff;
  color: #4f46e5;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 15px;
}

.info-icon.warning {
  background: #fff7ed;
  color: #d97706;
}

.info-icon.price {
  background: #ecfdf3;
  color: #15803d;
}

.info-item span {
  display: block;
  margin-bottom: 3px;
  color: #8b95a5;
  font-size: 11px;
}

.info-item strong {
  color: #293241;
  font-size: 14px;
  font-weight: 700;
}

.info-divider {
  width: 1px;
  height: 35px;
  background: #e2e7ed;
}

/* =========================================
   FORM ACTIONS
========================================= */

.form-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  padding: 20px 4px 4px;
  margin-bottom: 10px;
}

.required-note {
  color: #8b95a5;
  font-size: 12px;
}

.required-note span {
  color: #dc2626;
  font-weight: 700;
}

.action-buttons {
  display: flex;
  align-items: center;
  gap: 10px;
}

/* =========================================
   RESPONSIVE
========================================= */

@media (max-width: 900px) {

  .medicine-form-page {
    padding: 22px;
  }

  .page-header {
    align-items: flex-start;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .stock-info {
    grid-template-columns: 1fr;
    gap: 15px;
  }

  .info-divider {
    display: none;
  }

  .info-item {
    padding: 0;
  }
}


@media (max-width: 650px) {

  .medicine-form-page {
    padding: 16px;
  }

  .page-header {
    flex-direction: column;
    align-items: stretch;
    gap: 16px;
  }

  .page-header h1 {
    font-size: 23px;
  }

  .header-actions {
    width: 100%;
  }

  .header-actions .btn {
    width: 100%;
  }

  .card-header {
    padding: 17px;
  }

  .card-body {
    padding: 17px;
  }

  .form-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .action-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .action-buttons .btn-primary {
    grid-column: 1 / -1;
    width: 100%;
  }

  .action-buttons .btn {
    width: 100%;
  }

  .required-note {
    text-align: center;
  }
}


@media (max-width: 420px) {

  .medicine-form-page {
    padding: 12px;
  }

  .breadcrumb {
    font-size: 11px;
    gap: 5px;
  }

  .page-header h1 {
    font-size: 21px;
  }

  .page-header p {
    font-size: 12px;
  }

  .card-header {
    gap: 10px;
  }

  .header-icon {
    width: 38px;
    height: 38px;
    font-size: 16px;
  }

  .card-header h2 {
    font-size: 14px;
  }

  .card-header p {
    font-size: 11px;
  }

  .card-body {
    padding: 14px;
  }

  .action-buttons {
    grid-template-columns: 1fr;
  }

  .action-buttons .btn-primary {
    grid-column: auto;
  }
}
