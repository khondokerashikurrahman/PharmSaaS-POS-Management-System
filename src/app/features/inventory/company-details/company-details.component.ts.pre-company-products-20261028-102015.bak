import { Component, OnInit } from '@angular/core';
import { CommonModule } from '@angular/common';
import { Router, ActivatedRoute } from '@angular/router';
import { CompanyApiService } from '../../../core/services/company-api.service';

interface CompanyModel {
  apiId: number;
  id: string;
  name: string;
  contactPerson: string;
  phone: string;
  email: string;
  address: string;
  medicines: number;
  totalPurchases: number;
  dueAmount: number;
  status: 'Active' | 'Inactive';
}

@Component({
  selector: 'app-company-details',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './company-details.component.html',
  styleUrl: './company-details.component.scss'
})
export class CompanyDetailsComponent implements OnInit {
  companyId = '';
  loading = false;
  errorMessage = '';

  company: CompanyModel = {
    apiId: 0, id: '', name: '', contactPerson: '', phone: '',
    email: '', address: '', medicines: 0, totalPurchases: 0,
    dueAmount: 0, status: 'Active'
  };

  medicines: Array<{
    name: string; generic: string; category: string;
    stock: number; purchasePrice: number; salePrice: number; status: string;
  }> = [];

  purchases: Array<{
    invoice: string; date: string; amount: number;
    paid: number; due: number; status: string;
  }> = [];

  constructor(
    private router: Router,
    private route: ActivatedRoute,
    private api: CompanyApiService
  ) {}

  ngOnInit(): void {
    this.companyId = this.route.snapshot.paramMap.get('id') || '';
    this.loadCompany();
  }

  private tenantId(): number {
    return Number(localStorage.getItem('tenantId') || 0);
  }

  loadCompany(): void {
    const tenantId = this.tenantId();
    const id = Number(this.companyId);

    if (!tenantId || !Number.isInteger(id) || id <= 0) {
      this.errorMessage = 'Invalid company ID. Company list থেকে record খোলো।';
      return;
    }

    this.loading = true;
    this.errorMessage = '';
    this.api.get(tenantId, id).subscribe({
      next: c => {
        this.company = {
          apiId: c.id,
          id: c.companyCode,
          name: c.name || '',
          contactPerson: c.contactPerson || '',
          phone: c.phone || '',
          email: c.email || '',
          address: c.address || '',
          medicines: 0,
          totalPurchases: 0,
          dueAmount: 0,
          status: c.status === 'Inactive' ? 'Inactive' : 'Active'
        };
        this.loading = false;
      },
      error: err => {
        this.loading = false;
        this.errorMessage = err?.error?.message ||
          'Company details load করা যায়নি।';
      }
    });
  }

  get totalStock(): number {
    return this.medicines.reduce((sum, m) => sum + m.stock, 0);
  }

  get lowStockCount(): number {
    return this.medicines.filter(m => m.status === 'Low Stock').length;
  }

  goBack(): void {
    this.router.navigate(['/app/inventory/companies']);
  }

  editCompany(): void {
    this.router.navigate([
      '/app/inventory/companies', this.company.apiId, 'edit'
    ]);
  }

  viewMedicine(medicine: unknown): void {
    console.log('View medicine:', medicine);
  }
}
