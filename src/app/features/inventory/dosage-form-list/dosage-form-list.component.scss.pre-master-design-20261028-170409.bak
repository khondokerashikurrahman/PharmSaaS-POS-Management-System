.dosage-page {
  padding: 1.25rem;
  background: var(--bs-body-bg, #fff);
  border-radius: 12px;
}
.page-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1.25rem;
}
.page-heading h2 {
  margin: 0 0 .35rem;
  font-size: 1.4rem;
  font-weight: 700;
}
.page-heading p {
  margin: 0;
  color: var(--bs-secondary-color, #6c757d);
}
.dosage-form-card {
  max-width: 820px;
  padding: 1rem;
  margin-bottom: 1.25rem;
  border: 1px solid var(--bs-border-color, #dee2e6);
  border-radius: 10px;
}
.dosage-form-card label {
  display: block;
  margin-bottom: .45rem;
  font-weight: 600;
}
.form-row {
  display: flex;
  flex-wrap: wrap;
  gap: .6rem;
}
.form-row input {
  flex: 1 1 240px;
  min-width: 0;
}
.table-wrap {
  overflow-x: auto;
}
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: .4rem;
}
