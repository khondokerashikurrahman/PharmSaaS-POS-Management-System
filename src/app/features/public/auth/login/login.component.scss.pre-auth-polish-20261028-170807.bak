// ==========================================
// LOGIN PAGE
// ==========================================

.login-page {
  min-height: 100vh;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30px;
  box-sizing: border-box;

  background:
    linear-gradient(
      135deg,
      #f0fdf4 0%,
      #ecfdf5 45%,
      #f8fafc 100%
    );

  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}


// ==========================================
// MAIN CONTAINER
// ==========================================

.login-container {
  width: 100%;
  max-width: 1050px;
  min-height: 650px;

  display: grid;
  grid-template-columns: 1fr 1fr;

  background: #ffffff;

  border-radius: 22px;

  overflow: hidden;

  box-shadow:
    0 25px 60px rgba(15, 23, 42, 0.12);
}


// ==========================================
// LEFT BRAND SECTION
// ==========================================

.login-brand {
  display: flex;
  flex-direction: column;
  justify-content: center;

  padding: 60px;

  background:
    linear-gradient(
      145deg,
      #047857 0%,
      #059669 50%,
      #10b981 100%
    );

  color: #ffffff;

  position: relative;
  overflow: hidden;
}


// Decorative circles

.login-brand::before {
  content: "";

  position: absolute;

  width: 280px;
  height: 280px;

  border-radius: 50%;

  background: rgba(255, 255, 255, 0.07);

  top: -100px;
  right: -100px;
}

.login-brand::after {
  content: "";

  position: absolute;

  width: 220px;
  height: 220px;

  border-radius: 50%;

  background: rgba(255, 255, 255, 0.06);

  bottom: -90px;
  left: -90px;
}


// ==========================================
// BRAND LOGO
// ==========================================

.brand-logo {
  width: 72px;
  height: 72px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: rgba(255, 255, 255, 0.15);

  border: 1px solid rgba(255, 255, 255, 0.2);

  border-radius: 18px;

  font-size: 34px;

  margin-bottom: 28px;

  position: relative;
  z-index: 1;

  backdrop-filter: blur(8px);
}


// ==========================================
// BRAND TITLE
// ==========================================

.login-brand h1 {
  margin: 0 0 12px;

  font-size: 42px;

  font-weight: 800;

  letter-spacing: -1px;

  position: relative;
  z-index: 1;
}


.login-brand > p {
  margin: 0;

  font-size: 18px;

  line-height: 1.6;

  color: rgba(255, 255, 255, 0.9);

  position: relative;
  z-index: 1;
}


// ==========================================
// BRAND FEATURES
// ==========================================

.brand-features {
  margin-top: 45px;

  display: flex;
  flex-direction: column;

  gap: 18px;

  position: relative;
  z-index: 1;
}


.brand-features div {
  font-size: 15px;

  color: rgba(255, 255, 255, 0.95);

  display: flex;
  align-items: center;

  line-height: 1.5;
}


// ==========================================
// RIGHT LOGIN SECTION
// ==========================================

.login-form-section {
  display: flex;
  align-items: center;
  justify-content: center;

  padding: 45px;

  background: #ffffff;
}


// ==========================================
// LOGIN CARD
// ==========================================

.login-card {
  width: 100%;
  max-width: 410px;
}


// ==========================================
// MOBILE LOGO
// ==========================================

.mobile-logo {
  display: none;

  width: 58px;
  height: 58px;

  align-items: center;
  justify-content: center;

  background: #ecfdf5;

  border-radius: 15px;

  font-size: 28px;

  margin-bottom: 20px;
}


// ==========================================
// HEADING
// ==========================================

.login-card h2 {
  margin: 0;

  font-size: 30px;

  font-weight: 750;

  color: #111827;

  letter-spacing: -0.5px;
}


.subtitle {
  margin: 9px 0 30px;

  color: #6b7280;

  font-size: 14px;

  line-height: 1.5;
}


// ==========================================
// ERROR MESSAGE
// ==========================================

.error-message {
  width: 100%;

  box-sizing: border-box;

  padding: 12px 14px;

  margin-bottom: 20px;

  border-radius: 9px;

  background: #fef2f2;

  border: 1px solid #fecaca;

  color: #dc2626;

  font-size: 13px;

  line-height: 1.5;
}


// ==========================================
// FORM GROUP
// ==========================================

.form-group {
  margin-bottom: 21px;
}


// ==========================================
// LABEL
// ==========================================

.form-group > label,
.password-label label {
  display: block;

  margin-bottom: 8px;

  font-size: 13px;

  font-weight: 600;

  color: #374151;
}


// ==========================================
// INPUT
// ==========================================

.form-group input[type="email"],
.form-group input[type="password"],
.form-group input[type="text"] {
  width: 100%;

  height: 48px;

  padding: 0 14px;

  box-sizing: border-box;

  border: 1px solid #d1d5db;

  border-radius: 9px;

  outline: none;

  background: #ffffff;

  color: #111827;

  font-size: 14px;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}


.form-group input::placeholder {
  color: #9ca3af;
}


.form-group input:hover {
  border-color: #9ca3af;
}


.form-group input:focus {
  border-color: #059669;

  box-shadow:
    0 0 0 3px rgba(5, 150, 105, 0.1);

  background: #ffffff;
}


// ==========================================
// PASSWORD LABEL
// ==========================================

.password-label {
  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-bottom: 8px;
}


.password-label label {
  margin-bottom: 0;
}


// ==========================================
// FORGOT PASSWORD
// ==========================================

.forgot-password {
  border: 0;

  padding: 0;

  background: transparent;

  color: #059669;

  font-size: 12px;

  font-weight: 600;

  cursor: pointer;

  transition: color 0.2s ease;
}


.forgot-password:hover {
  color: #047857;

  text-decoration: underline;
}


// ==========================================
// PASSWORD INPUT WRAPPER
// ==========================================

.password-input {
  position: relative;

  width: 100%;
}


// Password input inside wrapper

.password-input input {
  width: 100%;

  padding-right: 75px !important;
}


// ==========================================
// PASSWORD TOGGLE
// ==========================================

.password-toggle {
  position: absolute;

  right: 12px;

  top: 50%;

  transform: translateY(-50%);

  border: 0;

  background: transparent;

  color: #059669;

  font-size: 12px;

  font-weight: 700;

  cursor: pointer;

  padding: 5px 4px;

  z-index: 2;
}


.password-toggle:hover {
  color: #047857;
}


// ==========================================
// REMEMBER ME
// ==========================================

.remember-row {
  margin: 2px 0 22px;
}


.remember-row label {
  display: flex;

  align-items: center;

  gap: 8px;

  color: #6b7280;

  font-size: 13px;

  cursor: pointer;
}


.remember-row input {
  width: 15px;
  height: 15px;

  margin: 0;

  accent-color: #059669;

  cursor: pointer;
}


// ==========================================
// LOGIN BUTTON
// ==========================================

.login-btn {
  width: 100%;

  height: 49px;

  border: 0;

  border-radius: 9px;

  background:
    linear-gradient(
      135deg,
      #059669,
      #047857
    );

  color: #ffffff;

  font-size: 14px;

  font-weight: 700;

  cursor: pointer;

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    opacity 0.2s ease;
}


.login-btn:hover:not(:disabled) {
  transform: translateY(-1px);

  box-shadow:
    0 8px 20px rgba(5, 150, 105, 0.25);
}


.login-btn:active:not(:disabled) {
  transform: translateY(0);
}


.login-btn:disabled {
  opacity: 0.55;

  cursor: not-allowed;

  box-shadow: none;
}


// ==========================================
// DEMO INFO
// ==========================================

.demo-info {
  margin-top: 25px;

  padding: 16px;

  background: #f8fafc;

  border: 1px solid #e5e7eb;

  border-radius: 10px;

  color: #6b7280;

  font-size: 12px;

  line-height: 1.6;
}


.demo-info strong {
  color: #374151;
}


.demo-info > strong {
  display: block;

  margin-bottom: 9px;

  font-size: 13px;

  color: #059669;
}


.demo-info p {
  margin: 6px 0;
}


.demo-info p strong {
  color: #374151;
}


// ==========================================
// FOOTER
// ==========================================

.login-footer {
  margin-top: 25px;

  text-align: center;

  color: #9ca3af;

  font-size: 11px;

  line-height: 1.5;
}


// ==========================================
// TABLET
// ==========================================

@media (max-width: 850px) {

  .login-page {
    padding: 20px;
  }

  .login-container {
    max-width: 700px;

    grid-template-columns: 1fr;

    min-height: auto;
  }

  .login-brand {
    display: none;
  }

  .login-form-section {
    padding: 45px 35px;
  }

  .mobile-logo {
    display: flex;
  }
}


// ==========================================
// MOBILE
// ==========================================

@media (max-width: 520px) {

  .login-page {
    min-height: 100vh;

    padding: 0;

    align-items: stretch;

    background: #ffffff;
  }

  .login-container {
    width: 100%;

    min-height: 100vh;

    border-radius: 0;

    box-shadow: none;
  }

  .login-form-section {
    padding: 30px 22px;

    align-items: flex-start;

    padding-top: 55px;
  }

  .login-card {
    max-width: 100%;
  }

  .mobile-logo {
    width: 52px;
    height: 52px;

    font-size: 25px;

    margin-bottom: 18px;
  }

  .login-card h2 {
    font-size: 27px;
  }

  .subtitle {
    margin-bottom: 25px;
  }

  .form-group {
    margin-bottom: 18px;
  }

  .demo-info {
    margin-top: 22px;
  }

  .login-footer {
    margin-top: 22px;
    padding-bottom: 15px;
  }
}


// ==========================================
// SMALL MOBILE
// ==========================================

@media (max-width: 360px) {

  .login-form-section {
    padding-left: 17px;
    padding-right: 17px;
  }

  .login-card h2 {
    font-size: 24px;
  }

  .password-label {
    align-items: flex-start;

    gap: 8px;
  }

  .forgot-password {
    font-size: 11px;
  }
}