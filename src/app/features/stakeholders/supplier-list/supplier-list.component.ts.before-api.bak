    }
  ];

  constructor(private router: Router) {}

  get filteredSuppliers(): Supplier[] {
    const search = this.searchTerm.trim().toLowerCase();

    return this.suppliers.filter(supplier => {

      const matchesSearch =
        !search ||
        supplier.id.toLowerCase().includes(search) ||
        supplier.name.toLowerCase().includes(search) ||
        supplier.contactPerson.toLowerCase().includes(search) ||
        supplier.phone.toLowerCase().includes(search) ||
        supplier.email.toLowerCase().includes(search);

      const matchesStatus =
        this.statusFilter === 'All' ||
        supplier.status === this.statusFilter;

      return matchesSearch && matchesStatus;
    });
  }

  get totalSuppliers(): number {
    return this.suppliers.length;
  }

  get activeSuppliers(): number {
    return this.suppliers.filter(
      supplier => supplier.status === 'Active'
    ).length;
  }

  get inactiveSuppliers(): number {
    return this.suppliers.filter(
      supplier => supplier.status === 'Inactive'
    ).length;
  }

  get totalDue(): number {
    return this.suppliers.reduce(
      (total, supplier) => total + supplier.dueAmount,
      0
    );
  }

  get totalPurchases(): number {
    return this.suppliers.reduce(
      (total, supplier) => total + supplier.totalPurchases,
      0
    );
  }

  getInitial(name: string): string {
    return name.charAt(0).toUpperCase();
  }

  getStatusClass(status: string): string {
    return status === 'Active'
      ? 'status-active'
      : 'status-inactive';
  }

  viewSupplier(id: string): void {
    alert(`Supplier details for ${id} will open here.`);
  }

  openLedger(id: string): void {
    this.router.navigate(
      ['/app/stakeholders/suppliers/ledger'],
      {
        queryParams: {
          supplierId: id
        }
      }
    );
  }

  addSupplier(): void {
    alert('Add Supplier form will open here.');
  }
}