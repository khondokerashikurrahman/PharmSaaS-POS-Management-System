  goBack(): void {
    this.router.navigate(['/app/stakeholders/suppliers']);
  }

  openLedger(): void {
    if (!this.supplier) return;

    this.router.navigate(
      ['/app/stakeholders/suppliers/ledger'],
      {
        queryParams: {
          supplierId: this.supplier.id
        }
      }
    );
  }

  editSupplier(): void {
    alert('Supplier edit form will be connected here.');
  }

  printDetails(): void {
    window.print();
  }

  getStatusClass(status: string): string {
    return status === 'Active'
      ? 'status-active'
      : 'status-inactive';
  }

  getPurchaseStatusClass(status: string): string {
    return status === 'Paid'
      ? 'purchase-paid'
      : 'purchase-partial';
