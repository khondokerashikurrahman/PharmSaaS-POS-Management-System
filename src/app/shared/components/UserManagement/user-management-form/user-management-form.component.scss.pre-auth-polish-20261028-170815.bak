
:host {
  display: block;
  margin-bottom: 26px;
  color: #17243a;
}

.user-form-card {
  position: relative;
  overflow: hidden;
  padding: 28px;
  background: var(--card-bg, #fff);
  border: 1px solid #e5eaf2;
  border-radius: 22px;
  box-shadow: 0 8px 30px rgba(23, 36, 58, 0.045);
}

.user-form-card::before {
  content: "";
  position: absolute;
  inset: 0 0 auto;
  height: 4px;
  background: linear-gradient(90deg, #315bea, #7c68ee, #44b7cf);
}

.form-heading {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 26px;

  h2 {
    margin: 0 0 7px;
    color: #17243a;
    font-size: 21px;
    font-weight: 750;
    letter-spacing: -0.55px;
  }

  p {
    margin: 0;
    color: #7b8799;
    font-size: 13px;
    line-height: 1.65;
  }
}

.heading-icon {
  display: grid;
  place-items: center;
  flex: 0 0 50px;
  width: 50px;
  height: 50px;
  border: 1px solid #dce5ff;
  border-radius: 16px;
  background: linear-gradient(145deg, #edf2ff, #e8eaff);
  color: #315bea;
  font-size: 28px;
  font-weight: 500;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px 24px;
}

label {
  display: grid;
  align-content: start;
  gap: 9px;
  color: #344258;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.1px;
}

input,
select {
  display: block;
  width: 100%;
  min-width: 0;
  min-height: 47px;
  box-sizing: border-box;
  padding: 12px 14px;
  border: 1px solid #dfe5ee;
  border-radius: 12px;
  background: #fafbfd;
  color: #1b2940;
  font-family: inherit;
  font-size: 13px;
  font-weight: 400;
  outline: none;
  transition: border-color 180ms ease, box-shadow 180ms ease,
    background 180ms ease;

  &::placeholder {
    color: #a0a9b8;
  }

  &:hover {
    border-color: #c6d1e2;
  }

  &:focus {
    border-color: #5575ef;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(79, 114, 238, 0.1);
  }
}

select {
  cursor: pointer;
}

small {
  color: #d33b50;
  font-size: 11px;
  font-weight: 500;
  line-height: 1.5;
}

.form-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-top: 27px;
  padding-top: 21px;
  border-top: 1px solid #edf0f5;

  span {
    max-width: 420px;
    color: #8490a2;
    font-size: 12px;
    line-height: 1.7;
  }

  button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 9px;
    min-height: 45px;
    padding: 12px 21px;
    border: 1px solid #315bea;
    border-radius: 12px;
    background: linear-gradient(135deg, #3764ed, #4c4ce0);
    color: #fff;
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
    cursor: pointer;
    box-shadow: 0 5px 13px rgba(49, 91, 234, 0.17);
    transition: transform 180ms ease, box-shadow 180ms ease,
      opacity 180ms ease;

    &:hover:not(:disabled) {
      transform: translateY(-1px);
      box-shadow: 0 8px 18px rgba(49, 91, 234, 0.23);
    }

    &:disabled {
      opacity: 0.6;
      cursor: wait;
      box-shadow: none;
    }

    &:focus-visible {
      outline: 3px solid rgba(79, 114, 238, 0.25);
      outline-offset: 3px;
    }
  }
}

.notice {
  margin-bottom: 18px;
  padding: 13px 15px;
  border: 1px solid transparent;
  border-radius: 12px;
  font-size: 13px;
  line-height: 1.6;
}

.success {
  border-color: #c7eed6;
  background: #f0fbf4;
  color: #167443;
}

.error {
  border-color: #ffd5dc;
  background: #fff4f5;
  color: #be123c;
}

@media (max-width: 700px) {
  .user-form-card {
    padding: 22px 18px;
    border-radius: 18px;
  }

  .form-heading {
    align-items: flex-start;
  }

  .form-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
  }

  .form-footer {
    align-items: stretch;
    flex-direction: column;

    button {
      width: 100%;
    }
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    transition-duration: 0.01ms !important;
  }
}
