  font-size: 13px;
  font-weight: 600;
  padding: 30px 0;
  transition: color 0.2s ease;
}

.nav-menu a:hover,
.nav-menu a.active {
  color: #2563eb;
}

.nav-menu a.active::after {
  bottom: 19px;
  height: 3px;
  border-radius: 10px;
}

.navbar-actions {
  gap: 10px;
}

.login-btn,
.get-started-btn {
  height: 42px;
