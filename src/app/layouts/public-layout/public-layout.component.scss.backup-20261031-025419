
/* ================================
   PUBLIC LAYOUT
================================ */

.public-layout {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}


/* ================================
   NAVBAR
================================ */

.public-navbar {
  position: sticky;
  top: 0;
  z-index: 1000;

  height: 72px;

  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1px solid #e8edf3;

  backdrop-filter: blur(10px);
}


.navbar-container {
  width: min(1180px, calc(100% - 40px));
  height: 100%;

  margin: 0 auto;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}


/* ================================
   BRAND
================================ */

.brand {
  display: flex;
  align-items: center;
  gap: 10px;

  text-decoration: none;
  flex-shrink: 0;
}


.brand-icon {
  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #2563eb;
  color: #ffffff;

  border-radius: 10px;

  font-size: 20px;
}


.brand-text {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}


.brand-name {
  color: #172033;
  font-size: 20px;
  font-weight: 700;
  letter-spacing: -0.3px;
}


.brand-tagline {
  margin-top: 3px;

  color: #7b8798;
  font-size: 10px;
  font-weight: 500;
}


/* ================================
   NAV MENU
================================ */

.nav-menu {
  display: flex;
  align-items: center;
  gap: 30px;

  margin-left: auto;
}


.nav-menu a {
  position: relative;

  color: #536174;

  text-decoration: none;

  font-size: 14px;
  font-weight: 500;

  padding: 26px 0;

  transition:
    color 0.2s ease;
}


.nav-menu a:hover {
  color: #2563eb;
}


.nav-menu a.active {
  color: #2563eb;
  font-weight: 600;
}


/* Active underline */

.nav-menu a.active::after {
  content: "";

  position: absolute;

  left: 0;
  right: 0;
  bottom: 17px;

  height: 2px;

  background: #2563eb;

  border-radius: 10px;
}


/* ================================
   NAVBAR ACTIONS
================================ */

.navbar-actions {
  display: flex;
  align-items: center;
  gap: 12px;

  flex-shrink: 0;
}


.login-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  height: 40px;
  padding: 0 17px;

  color: #334155;

  text-decoration: none;

  font-size: 14px;
  font-weight: 600;

  border: 1px solid #dce3ec;
  border-radius: 8px;

  background: #ffffff;

  transition: all 0.2s ease;
}


.login-btn:hover {
  border-color: #2563eb;
  color: #2563eb;
}


.get-started-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  height: 40px;
  padding: 0 18px;

  color: #ffffff;

  text-decoration: none;

  font-size: 14px;
  font-weight: 600;

  background: #2563eb;

  border: 1px solid #2563eb;
  border-radius: 8px;

  transition: all 0.2s ease;
}


.get-started-btn:hover {
  background: #1d4ed8;
  border-color: #1d4ed8;

  transform: translateY(-1px);
}


/* ================================
   MAIN CONTENT
================================ */

.public-content {
  flex: 1;
  min-height: calc(100vh - 72px);
}


/* ================================
   FOOTER
================================ */
/* =========================
   PUBLIC FOOTER
========================= */

.public-footer {
  background: #111827;
  color: #cbd5e1;
  padding: 75px 0 0;
  margin-top: 0;
}

.footer-container {
  width: min(1200px, 92%);
  margin: 0 auto;

  display: grid;
  grid-template-columns: 2fr repeat(4, 1fr);
  gap: 55px;

  padding-bottom: 65px;
}


/* =========================
   FOOTER BRAND
========================= */

.footer-brand {
  max-width: 360px;
}

.footer-logo {
  display: flex;
  align-items: center;
  gap: 13px;
  margin-bottom: 22px;
}

.footer-logo-icon {
  width: 44px;
  height: 44px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 12px;

  background: #2563eb;
  color: #ffffff;

  font-size: 20px;
}

.footer-logo strong {
  display: block;

  color: #ffffff;
  font-size: 20px;
  font-weight: 800;
}

.footer-logo span {
  display: block;

  margin-top: 3px;

  color: #94a3b8;
  font-size: 11px;
}

.footer-brand > p {
  margin: 0;

  color: #94a3b8;
  font-size: 14px;
  line-height: 1.8;
}

.footer-trust {
  display: flex;
  align-items: center;
  gap: 8px;

  margin-top: 22px;

  color: #cbd5e1;
  font-size: 12px;
  font-weight: 600;
}

.footer-trust i {
  color: #60a5fa;
  font-size: 16px;
}


/* =========================
   FOOTER COLUMNS
========================= */

.footer-column h4 {
  margin: 5px 0 20px;

  color: #ffffff;
  font-size: 14px;
  font-weight: 800;
}

.footer-column {
  display: flex;
  flex-direction: column;
  gap: 13px;
}

.footer-column a {
  width: fit-content;

  color: #94a3b8;
  text-decoration: none;

  font-size: 13px;

  cursor: pointer;

  transition: 0.2s ease;
}

.footer-column a:hover {
  color: #ffffff;
  transform: translateX(3px);
}


/* =========================
   FOOTER BOTTOM
========================= */

.footer-bottom {
  width: min(1200px, 92%);
  margin: 0 auto;

  min-height: 75px;

  border-top: 1px solid #263244;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;

  color: #64748b;
  font-size: 12px;
}

.footer-bottom-links {
  display: flex;
  gap: 25px;
}

.footer-bottom-links a {
  color: #64748b;
  text-decoration: none;
  transition: 0.2s ease;
}

.footer-bottom-links a:hover {
  color: #ffffff;
}


/* =========================
   RESPONSIVE
========================= */

@media (max-width: 950px) {

  .footer-container {
    grid-template-columns: 2fr repeat(2, 1fr);
    gap: 40px;
  }

}


@media (max-width: 650px) {

  .public-footer {
    padding-top: 55px;
  }

  .footer-container {
    grid-template-columns: 1fr 1fr;
    gap: 40px 25px;
  }

  .footer-brand {
    grid-column: 1 / -1;
    max-width: 100%;
  }

  .footer-bottom {
    min-height: 100px;

    flex-direction: column;
    justify-content: center;

    text-align: center;
  }

}


@media (max-width: 450px) {

  .footer-container {
    grid-template-columns: 1fr;
  }

  .footer-bottom-links {
    flex-direction: column;
    gap: 8px;
  }

}


/* ================================
   TABLET
================================ */

@media (max-width: 1000px) {

  .navbar-container {
    gap: 20px;
  }

  .nav-menu {
    gap: 18px;
  }

  .nav-menu a {
    font-size: 13px;
  }

  .brand-tagline {
    display: none;
  }

  .footer-container {
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 30px;
  }

}


/* ================================
   MOBILE
================================ */

@media (max-width: 760px) {

  .public-navbar {
    height: auto;
  }


  .navbar-container {
    width: calc(100% - 30px);

    padding: 12px 0;

    flex-wrap: wrap;

    justify-content: center;
  }


  .brand {
    margin-right: auto;
  }


  .navbar-actions {
    gap: 8px;
  }


  .login-btn,
  .get-started-btn {
    height: 36px;

    padding: 0 12px;

    font-size: 12px;
  }


  .nav-menu {
    order: 3;

    width: 100%;

    margin: 0;

    justify-content: center;

    gap: 20px;

    overflow-x: auto;
  }


  .nav-menu a {
    padding: 10px 0;

    white-space: nowrap;

    font-size: 13px;
  }


  .nav-menu a.active::after {
    bottom: 3px;
  }


  .footer-container {
    grid-template-columns: 1fr 1fr;

    padding: 40px 0;

    gap: 35px 25px;
  }


  .footer-brand {
    grid-column: 1 / -1;

    max-width: 100%;
  }


  .footer-bottom {
    flex-direction: column;

    align-items: flex-start;

    padding: 18px 0;
  }

}


/* ================================
   SMALL MOBILE
================================ */

@media (max-width: 480px) {

  .navbar-container {
    width: calc(100% - 24px);
  }


  .brand-name {
    font-size: 18px;
  }


  .brand-icon {
    width: 38px;
    height: 38px;
  }


  .navbar-actions {
    width: auto;
  }


  .get-started-btn {
    padding: 0 10px;
  }


  .nav-menu {
    gap: 16px;
    justify-content: flex-start;
  }


  .footer-container {
    grid-template-columns: 1fr;
  }


  .footer-column {
    grid-column: auto;
  }

}

