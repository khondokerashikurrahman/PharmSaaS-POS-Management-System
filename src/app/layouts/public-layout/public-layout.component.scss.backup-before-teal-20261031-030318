.public-layout {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.public-navbar {
  position: sticky;
  top: 0;
  z-index: 1000;
  min-height: 76px;
  background: rgba(8, 20, 38, 0.97);
  border-bottom: 1px solid rgba(148, 163, 184, 0.13);
  box-shadow: 0 8px 30px rgba(2, 8, 23, 0.22);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.navbar-container {
  position: relative;
  width: min(1320px, calc(100% - 56px));
  min-height: 76px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
  text-decoration: none;
}

.brand-icon {
  width: 46px;
  height: 46px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  color: #ffffff;
  background: linear-gradient(135deg, #3985ff, #0755e9);
  box-shadow: 0 0 22px rgba(23, 107, 255, 0.3);
  font-size: 22px;
}

.brand-text {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}

.brand-name {
  color: #ffffff;
  font-size: 21px;
  font-weight: 800;
  letter-spacing: -0.7px;
}

.brand-tagline {
  margin-top: 4px;
  color: #94a3b8;
  font-size: 10px;
  letter-spacing: 0.25px;
}

.nav-menu {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  margin-left: auto;
}

.nav-menu > a {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 11px 13px;
  border-radius: 9px;
  color: #c5d0df;
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  white-space: nowrap;
  transition: color 0.2s ease, background 0.2s ease;
}

.nav-menu > a:hover {
  color: #ffffff;
  background: rgba(59, 130, 246, 0.12);
}

.nav-menu > a.active {
  color: #60a5fa;
  background: rgba(37, 99, 235, 0.13);
}

.nav-menu > a.active::after {
  content: "";
  position: absolute;
  left: 13px;
  right: 13px;
  bottom: 3px;
  height: 2px;
  border-radius: 4px;
  background: #3985ff;
}

.navbar-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.login-btn,
.get-started-btn {
  min-height: 42px;
  padding: 0 19px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
}

.login-btn {
  color: #e2e8f0;
  background: transparent;
  border: 1px solid rgba(148, 163, 184, 0.35);
}

.login-btn:hover {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.08);
  border-color: #60a5fa;
}

.get-started-btn {
  color: #ffffff;
  background: linear-gradient(135deg, #3985ff, #0755e9);
  border: 1px solid #3985ff;
  box-shadow: 0 6px 20px rgba(23, 107, 255, 0.3);
}

.get-started-btn:hover {
  background: linear-gradient(135deg, #60a5fa, #176bff);
  box-shadow: 0 8px 26px rgba(23, 107, 255, 0.42);
  transform: translateY(-2px);
}

.mobile-menu-toggle,
.mobile-nav-actions {
  display: none;
}

.public-content {
  flex: 1;
  min-height: calc(100vh - 76px);
}

/* Footer */

.public-footer {
  margin-top: 0;
  padding: 75px 0 0;
  background: #111827;
  color: #cbd5e1;
}

.footer-container {
  width: min(1200px, 92%);
  margin: 0 auto;
  padding-bottom: 65px;
  display: grid;
  grid-template-columns: 2fr repeat(4, 1fr);
  gap: 55px;
}

.footer-brand {
  max-width: 360px;
}

.footer-logo {
  display: flex;
  align-items: center;
  gap: 13px;
  margin-bottom: 22px;
}

.footer-logo-icon {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: #2563eb;
  color: #ffffff;
  font-size: 20px;
}

.footer-logo strong {
  display: block;
  color: #ffffff;
  font-size: 20px;
  font-weight: 800;
}

.footer-logo span {
  display: block;
  margin-top: 3px;
  color: #94a3b8;
  font-size: 11px;
}

.footer-brand > p {
  margin: 0;
  color: #94a3b8;
  font-size: 14px;
  line-height: 1.8;
}

.footer-trust {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 22px;
  color: #cbd5e1;
  font-size: 12px;
  font-weight: 600;
}

.footer-trust i {
  color: #60a5fa;
  font-size: 16px;
}

.footer-column {
  display: flex;
  flex-direction: column;
  gap: 13px;
}

.footer-column h4 {
  margin: 5px 0 20px;
  color: #ffffff;
  font-size: 14px;
  font-weight: 800;
}

.footer-column a {
  width: fit-content;
  color: #94a3b8;
  font-size: 13px;
  text-decoration: none;
  cursor: pointer;
  transition: color 0.2s ease, transform 0.2s ease;
}

.footer-column a:hover {
  color: #ffffff;
  transform: translateX(3px);
}

.footer-bottom {
  width: min(1200px, 92%);
  min-height: 75px;
  margin: 0 auto;
  border-top: 1px solid #263244;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  color: #64748b;
  font-size: 12px;
}

.footer-bottom-links {
  display: flex;
  gap: 25px;
}

.footer-bottom-links a {
  color: #64748b;
  text-decoration: none;
  transition: color 0.2s ease;
}

.footer-bottom-links a:hover {
  color: #ffffff;
}

/* Tablet */

@media (max-width: 1050px) {
  .navbar-container {
    width: calc(100% - 32px);
    gap: 14px;
  }

  .nav-menu {
    gap: 1px;
  }

  .nav-menu > a {
    padding: 10px 8px;
    font-size: 12px;
  }

  .brand-tagline {
    display: none;
  }

  .footer-container {
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 30px;
  }
}

@media (max-width: 950px) {
  .footer-container {
    grid-template-columns: 2fr repeat(2, 1fr);
    gap: 40px;
  }
}

/* Mobile navigation */

@media (max-width: 760px) {
  .public-navbar {
    min-height: 66px;
  }

  .navbar-container {
    width: calc(100% - 28px);
    min-height: 66px;
    padding: 10px 0;
    gap: 0;
  }

  .brand {
    margin-right: auto;
  }

  .brand-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    font-size: 19px;
  }

  .brand-name {
    font-size: 19px;
  }

  .mobile-menu-toggle {
    width: 42px;
    height: 42px;
    margin-left: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 11px;
    background: #142944;
    color: #ffffff;
    font-size: 21px;
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .mobile-menu-toggle:hover {
    color: #60a5fa;
    background: #1b3558;
    border-color: #3985ff;
  }

  .navbar-actions {
    display: none;
  }

  .nav-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    z-index: 1001;
    display: none;
    flex-direction: column;
    align-items: stretch;
    gap: 3px;
    margin: 0;
    padding: 12px;
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 14px;
    background: #0c1c32;
    box-shadow: 0 18px 45px rgba(2, 8, 23, 0.38);
  }

  .nav-menu.mobile-open {
    display: flex;
  }

  .nav-menu > a {
    min-height: 44px;
    justify-content: flex-start;
    padding: 10px 13px;
    border-radius: 9px;
    color: #cbd5e1;
    font-size: 14px;
  }

  .nav-menu > a:hover,
  .nav-menu > a.active {
    color: #60a5fa;
    background: rgba(37, 99, 235, 0.15);
  }

  .nav-menu > a.active::after {
    display: none;
  }

  .mobile-nav-actions {
    display: flex;
    gap: 10px;
    padding: 13px 3px 5px;
    margin-top: 7px;
    border-top: 1px solid rgba(148, 163, 184, 0.18);
  }

  .mobile-nav-actions a {
    flex: 1;
    min-height: 42px;
    padding: 0 12px;
  }

  .mobile-nav-actions .login-btn {
    color: #e2e8f0;
    background: transparent;
    border: 1px solid rgba(148, 163, 184, 0.35);
  }

  .mobile-nav-actions .get-started-btn {
    color: #ffffff;
    background: linear-gradient(135deg, #3985ff, #0755e9);
  }

  .public-footer {
    padding-top: 55px;
  }

  .footer-container {
    grid-template-columns: 1fr 1fr;
    gap: 40px 25px;
  }

  .footer-brand {
    grid-column: 1 / -1;
    max-width: 100%;
  }

  .footer-bottom {
    min-height: 100px;
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }
}

@media (max-width: 450px) {
  .footer-container {
    grid-template-columns: 1fr;
  }

  .footer-column {
    grid-column: auto;
  }

  .footer-bottom-links {
    flex-direction: column;
    gap: 8px;
  }
}

@media (max-width: 380px) {
  .navbar-container {
    width: calc(100% - 20px);
  }

  .brand {
    gap: 7px;
  }

  .brand-name {
    font-size: 17px;
  }

  .brand-icon {
    width: 38px;
    height: 38px;
  }

  .mobile-menu-toggle {
    width: 39px;
    height: 39px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .public-layout * {
    scroll-behavior: auto !important;
    transition: none !important;
    animation: none !important;
  }
}
